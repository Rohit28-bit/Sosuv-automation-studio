# Copy to .env and adjust. Every setting is in src/sosuv/config.py (prefix SOSUV_).
SOSUV_ENV=dev
SOSUV_LOG_LEVEL=INFO
SOSUV_LOG_JSON=false

SOSUV_DATABASE_URL=postgresql+asyncpg://sosuv:sosuv@localhost:5432/sosuv
SOSUV_API_PORT=8000
SOSUV_CORS_ORIGINS=["http://localhost:5173"]

# Generate with: uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SOSUV_ENCRYPTION_KEY=

SOSUV_STORAGE_ROOT=./data/files
SOSUV_WORKER_CONCURRENCY=4
SOSUV_WORKER_QUEUES=["default"]
